{
  "name": "Edge Sidebar Toggle",
  "description": "Toggle a lightweight extension side panel with Alt+V.",
  "version": "0.1.0",
  "manifest_version": 3,
  "action": {
    "default_title": "Toggle Side Panel"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+V"
      },
      "description": "Toggle the extension side panel"
    }
  },
  "permissions": ["sidePanel", "storage"],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
